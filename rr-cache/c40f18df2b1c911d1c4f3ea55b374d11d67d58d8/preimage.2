export function isUnreadDoneThread(thread: ThreadStatusShape): boolean {
  switch (thread.status) {
    case "error":
    case "idle":
      return !isThreadRead(thread);
    case "active":
    case "starting":
    case "stopping":
    case "pending":
      return false;
    default:
      return assertNever(thread.status);
  }
}
