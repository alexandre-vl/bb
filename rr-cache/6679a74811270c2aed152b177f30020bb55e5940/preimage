export function hasFailedThreadRead(
  queryClient: QueryClient,
  threadId: string,
  latestAttentionAt: number,
): boolean {
  const byThread = failedThreadReads.get(queryClient);
  return (
    byThread?.has(threadId) === true &&
    byThread.get(threadId) === latestAttentionAt
  );
}

